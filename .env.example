# ==============================================================================
# Корневой Settings: Общесистемные настройки и параметры окружения приложения
# ==============================================================================

# Уникальное имя приложения (используется для логирования и идентификации сервиса)
APP_NAME = "llm-service"
# Флаг режима отладки (в продакшене выключен [false] для безопасности и скрытия технических ошибок)
DEBUG = False
# Список разрешенных адресов (источников) для механизмов Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS = ["http://localhost:3000"]
# Строка подключения (URL) к оперативной памяти/брокеру сообщений Redis для хранения кэша и сессий
REDIS_URL = "redis://localhost:6379/0"
# Время жизни кэшированных данных в секундах (3600 секунд = 1 час)
CACHE_TTL_SECONDS = 3600
# Уровень детализации системных логов (DEBUG — максимально подробный, включая трассировку запросов)
LOG_LEVEL = "DEBUG"
# Ограничение частоты запросов (Rate Limiting) для защиты API от перегрузок (макс. 30 запросов в минуту)
RATE_LIMIT_PER_MIN = 30
# Адрес прокси-сервера для работы по защищенному протоколу HTTPS (оставлен пустым, если не требуется)
HTTPS_PROXY = ""

# ==============================================================================
# LLMSettings: Настройки интеграции с большой языковой моделью (LLM)
# ==============================================================================
# Персональный API-ключ для авторизации в сервисе интеграции (провайдер ВсеGPT)
LLM__OPENAI_API_KEY = "sk-replace-me"
# Имя базовой языковой модели по умолчанию для генерации ответов и работы агентов
LLM__DEFAULT_MODEL = "gpt-4o-mini"
# Максимальное время ожидания ответа от API (в секундах) до генерации ошибки таймаута
LLM__REQUEST_TIMEOUT = 30.0
# Количество автоматических повторных попыток отправки запроса при сетевых сбоях или ошибках сервера
LLM__MAX_RETRIES = 3
# Базовый URL-адрес шлюза API
LLM__BASE_URL = "https://api.vsegpt.ru/v1"

# === Qdrant ===
# URL до Qdrant. В docker-compose сети — http://qdrant:6333, локально — http://localhost:6333.
QDRANT_URL=http://localhost:6333
# Опционально. Если пусто — Qdrant запускается без аутентификации (dev-режим).
# В production генерировать через `openssl rand -hex 32`.
QDRANT_API_KEY=
# Имя коллекции для документов проекта.
QDRANT_COLLECTION=documents
# Размерность вектора embedding-модели:
EMBEDDING_DIM=1024
# Имя embedding-модели — нужно для логов и (опционально) генерации векторов в скрипте загрузки.
EMBEDDING_MODEL=multilingual-e5-large

# === Chat storage ===
# Подключение к Postgres (async-драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat
# Пароль базы (используется в docker compose для POSTGRES_PASSWORD)
POSTGRES_PASSWORD=chat
# Какую реализацию репозитория использовать: json | postgres
CHAT_REPOSITORY=postgres
# Куда писать JSONL-файлы при CHAT_REPOSITORY=json
CHAT_STORAGE_DIR=./var
#подача историии для llm: sliding | hybrid
CHAT_CONTEXT_STRATEGY=hybrid
# Размер sliding window (сколько последних сообщений берём в контекст)
CHAT_CONTEXT_WINDOW=10

# === Telegram bot ===
BOT_TOKEN =  # токен от @BotFather
BACKEND_URL=http://app:8000
# === Service-to-service (POST /notify: backend → bot) ===
INTERNAL_TOKEN=change-me-with-openssl-rand-hex-32
BOT_URL=http://bot:9000
BOT_API_PORT=9000
PROXY_URL=""

#admin
#Сгенерировать: openssl rand -hex 32
#-join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
ADMIN_TOKEN=change-me-with-openssl-rand-hex-32
# Telegram chat_id админ-группы для alert drain (бот шлёт алерты сюда)
ADMIN_CHAT_ID=
# Включить OpenAI Moderation API (omni-moderation-latest)
MODERATION_USE_OPENAI=false
BOT_ADMIN_IDS=

#===Rag====
# Если top-1 score ниже порога — считаем, что ответа в корпусе нет.
RAG_SCORE_TRESHOLD=0.8
# Коллекция LlamaIndex
RAG_COLLECTION=rag_dot_46
# Корпус для индексации
RAG_DATA_DIR=data_rag/knowledge_base
# Сколько чанков отдаём в контекст и параметры нарезки.
RAG_TOP_K=3
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=64
# LLM для генерации ответа по контексту
RAG_LLM_MODEL=gpt-4o-mini
# Количество исходных текстовых чанков, извлекаемых из векторной БД (Qdrant) на первом этапе поиска
RAG_RETRIEVED_TOP_K = 10
# Флаг активации этапа реранкинга (переранжирования) для повышения релевантности контекста
RAG_USE_RERANKER = True
# Количество наиболее релевантных чанков, которые останутся после реранкинга и будут переданы в LLM
RAG_RERANK_TOP_K = 5
# Путь к локальной легковесной модели-реранкеру, оптимизированной для работы с русским языком (M3)
RAG_RERANK_MODEL = "app/models/bge-reranker-v2-m3"
# Модель ИИ, используемая для этапа Condense Question (сжатия истории чата и переформулирования запроса)
MODEL_CONDENSE = "gpt-4o-mini"

# === Phoenix-трейсинг (опционально, группа `tracing`) ===
# Инструментирование LlamaIndex и агентного графа (LangChain/LangGraph) в Phoenix.
# По умолчанию включено. Включить: PHOENIX_ENABLED=true + uv sync --extra tracing
# (или сервис phoenix в docker compose).
PHOENIX_ENABLED=True
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

#agent
# Бэкенд персистентности графа: memory (unit-тесты) | sqlite (локально) | postgres.
# В docker-compose ставится postgres (чекпоинты в тех же таблицах, что и БД сервиса).
AGENT_CHECKPOINTER=postgres
# Файл SQLite-чекпоинтера при AGENT_CHECKPOINTER=sqlite.
AGENT_SQL_PATH=var/agent_checkpoints.sqlite

# === Оценка качества RAGAS (опционально, группа `eval`) ===
#  anthropic|openai
EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=gpt-4o-mini
